# =============================================================================
# Shared.env — cross-path orchestration (all execution paths)
# =============================================================================
# Loaded after: Data.env (broker + data providers + paths + deploy infra slices)
# Loaded before: ORBSO.env, ORB0DTE.env, Trendline0DTE.env, Risk.env, Alerts.env
#
# --- Pass 3 ownership (May 2026) ---
# 1) True cross-path runtime — signal routing, trading mode shell, automation/demo/live,
#    ORB index capture, portfolio hygiene toggles, keys consumed by multiple strategies.
# 2) Shared options exit / quote policy — OPTION_STEALTH_* / OPTION_QUOTE_* / ORB_0DTE_SPREAD_OPEN_GRACE_*
#    (canonical; path envs override last-wins only when intentional).
# 3) Shared portfolio cap — MAX_TOTAL_OPTION_POSITIONS (combined ORB 0DTE + Trendline book).
# 4) ORB boundaries & index capture — ORB_BREAK_TOLERANCE, ORB_RTH_INTRADAY_SYMBOLS.
# 5) Execution gating — red-day filter, execution snapshots, duplicate-trade prevention.
# 6) Runtime shell — identity / TRADING_MODE / STRATEGY_MODE / AUTOMATION_MODE / core feature toggles.
# Kitchen-sink keys (May 2026 cleanup) moved to Data.env, Risk.env, Alerts.env, or profile defaults.
# Path-only knobs belong in ORBSO.env, ORB0DTE.env, or Trendline0DTE.env — not here.
# Path files use the same seven section group titles (1–7); see configs/README.md
# ("Path files — unified section groups").
# =============================================================================

# -----------------------------------------------------------------------------
# 1) True cross-path runtime (signal routing, modes, automation shell)
# -----------------------------------------------------------------------------
PRIMARY_SIGNAL_GENERATOR=orb

# -----------------------------------------------------------------------------
# 2) Options data policy (ORB 0DTE + Trendline 0DTE consumers)
# -----------------------------------------------------------------------------
# Enforce real broker option data for DEMO and LIVE.
REQUIRE_LIVE_OPTION_DATA=true
# Canonical owner for shared OPTION_STEALTH_* / OPTION_QUOTE_* defaults (path files may still override last-wins).
OPTIONS_EXIT_PROFILE=balanced

# -----------------------------------------------------------------------------
# 2b) Shared options exit / quote policy (ORB 0DTE + cross-path stealth / quote)
# -----------------------------------------------------------------------------
# ORB / spread / quote defaults; Trendline OPTION_STEALTH_TLINE_* canonical in this section (May 2026).
OPTION_STEALTH_ORB_BE_TRIGGER_MULT=0.75
OPTION_STEALTH_ORB_TRAILING_TRIGGER_MULT=0.85
OPTION_STEALTH_ORB_PROFIT_LOCK_TRIGGER_PCT=0.12
OPTION_STEALTH_ORB_PROFIT_LOCK_PCT=0.03
OPTION_STEALTH_SPREAD_BE_TRIGGER_PCT=0.18
OPTION_STEALTH_SPREAD_BE_LOCK_PCT=0.04
OPTION_STEALTH_SPREAD_TRAILING_TRIGGER_PCT=0.28
OPTION_STEALTH_SPREAD_BASE_TRAILING_PCT=0.12
OPTION_STEALTH_SPREAD_TIME_EXIT_MINUTES=9
OPTION_STEALTH_SPREAD_NO_PROGRESS_EXIT_MINUTES=6
OPTION_STEALTH_TIMEOUT_MIN_GOOD_MARK_TICKS=3
OPTION_STEALTH_NO_PROGRESS_FAVORABLE_UNDERLYING_MOVE_PCT=0.0035
OPTION_QUOTE_EXIT_GRADE_MAX_AGE_SECONDS=30
OPTION_QUOTE_STALE_MAX_AGE_SECONDS=90
OPTION_STEALTH_FREEZE_TIMEOUTS_ON_DEGRADED_MARKS=true
OPTION_STEALTH_REQUIRE_EXIT_GRADE_FOR_TIMEOUTS=true
OPTION_STEALTH_REQUIRE_EXIT_GRADE_FOR_WEAK_EXITS=true

# --- Trendline 0DTE stealth (OPTION_STEALTH_TLINE_*) — canonical here; Trendline0DTE.env no longer duplicates.
OPTION_STEALTH_TLINE_BE_TRIGGER_MULT=0.50
OPTION_STEALTH_TLINE_TRAILING_TRIGGER_MULT=0.82
# Trendline 0DTE single-leg: faster BE / trail / profit lock (canonical; May 2026).
OPTION_STEALTH_TLINE_BE_DELTA_HIGH_THRESHOLD=0.50
OPTION_STEALTH_TLINE_BE_DELTA_MID_THRESHOLD=0.35
OPTION_STEALTH_TLINE_BE_TRIGGER_HIGH_DELTA_PCT=0.10
OPTION_STEALTH_TLINE_BE_TRIGGER_MID_DELTA_PCT=0.12
OPTION_STEALTH_TLINE_BE_TRIGGER_LOW_DELTA_PCT=0.15
OPTION_STEALTH_TLINE_PROFIT_LOCK_TRIGGER_PCT=0.08
OPTION_STEALTH_TLINE_PROFIT_LOCK_PCT=0.02
OPTION_STEALTH_TLINE_MICRO_LOCK_TRIGGER_PCT=0.05
OPTION_STEALTH_TLINE_CHOP_HOLD_MIN_PNL_PCT=0.10
OPTION_STEALTH_TLINE_IMPULSE_TP_TARGET_PCT=0.50
OPTION_STEALTH_TLINE_IMPULSE_TRAILING_TRIGGER_PCT=0.18
OPTION_STEALTH_TLINE_IMPULSE_TRAILING_PCT=0.12
OPTION_STEALTH_TLINE_IMPULSE_TRAIL_ACTIVATION_CAP_DEGRADED=0.22
OPTION_STEALTH_TLINE_IMPULSE_TIME_EXIT_MINUTES=12
OPTION_STEALTH_TLINE_IMPULSE_NO_PROGRESS_EXIT_MINUTES=5
OPTION_STEALTH_TLINE_NO_PROGRESS_EXIT_MINUTES=6
# Single-leg "early" scratch (was 4m; May 2026): default 7m; only fires when structure invalid AND underlying not favorable vs entry.
OPTION_STEALTH_TLINE_NO_PROGRESS_EARLY_MINUTES=7
OPTION_STEALTH_TLINE_NO_PROGRESS_EARLY_MAX_PNL_PCT=0.05
OPTION_STEALTH_TLINE_UNDERLYING_OPPORTUNITY_PCT=0.0025
OPTION_STEALTH_TLINE_UNDERLYING_RECLAIM_PROTECT=true
OPTION_STEALTH_TLINE_MIN_HOLD_BYPASS_MFE_PCT=0.05
OPTION_STEALTH_TLINE_BE_RELAX_HWM_WITH_UNDERLYING=true
OPTION_STEALTH_TLINE_BE_RELAX_HWM_MIN_PNL_PCT=0.02
OPTION_STEALTH_TLINE_NO_PROGRESS_SINGLE_RELAX_EXIT_GRADE=true
OPTION_STEALTH_TLINE_NO_PROGRESS_SINGLE_MAX_MFE_PCT=0.05
OPTION_STEALTH_STATE_LOG_SECONDS=15
OPTION_STEALTH_TLINE_EARLY_TRAILING_TRIGGER_PCT=0.30
OPTION_STEALTH_TLINE_EARLY_TRAILING_PCT=0.24
OPTION_STEALTH_TLINE_EARLY_TIME_EXIT_MINUTES=30

# --- Trendline monitoring & option no-data (Prime + option stealth; canonical here May 2026) ---
TRENDLINE_OPTION_NO_DATA_GRACE_SECONDS=180
TRENDLINE_OPTION_FORCE_EXIT_NO_DATA_SECONDS=300
TRENDLINE_OPTION_REQUIRE_EXIT_GRADE_BEFORE_FORCE_EXIT=true
TRENDLINE_MIN_DIAGNOSTIC_HOLD_SECONDS=120
TRENDLINE_POSITION_MONITOR_INTERVAL_SEC=7
TRENDLINE_POSITION_MONITOR_INTERVAL_SEC_DYNAMIC=true
TRENDLINE_MONITOR_ALERT_INTERVAL_SEC=300
TRENDLINE_MONITOR_ALERT_ENABLED=false
TRENDLINE_MONITOR_ALERT_ONLY_ON_CHANGE=true
TRENDLINE_MONITOR_ALERT_GLOBAL_DEDUP_ENABLED=true
TRENDLINE_MONITOR_ALERT_GLOBAL_DEDUP_FAIL_OPEN=true
TRENDLINE_MONITOR_ALERT_GLOBAL_DEDUP_NAMESPACE=trendline_monitor_alerts

ORB_0DTE_SPREAD_OPEN_GRACE_SECONDS=60
ORB_0DTE_SPREAD_OPEN_GRACE_MAX_ATTEMPTS=6
ORB_0DTE_SPREAD_OPEN_GRACE_ENABLE_SYNTHETIC=true
OPTION_0DTE_FAST_UNDERLYING_MOVE_ABS=0.50
OPTION_0DTE_FAST_ENTRY_MINUTES=10.0

# ORB 0DTE spread — trusted degraded marks, watchdog clock recovery, degraded-running slack (May 2026).
OPTION_STEALTH_ORB_TRUSTED_DEGRADED_SPREAD_ENABLE=true
OPTION_STEALTH_ORB_TRUSTED_DEGRADED_MAX_MARK_AGE_SECONDS=90
OPTION_STEALTH_ORB_TRUSTED_DEGRADED_MIN_FRESH_LEG_AGE_SECONDS=45
OPTION_STEALTH_ORB_UNDERLYING_OPPORTUNITY_PCT=0.0025
OPTION_STEALTH_ORB_DEGRADED_PROTECT=true
OPTION_STEALTH_ORB_DEGRADED_RUNNING_TIME_EXIT_SLACK_MIN=1.5
OPTION_STEALTH_ORB_DEGRADED_RUNNING_NO_PROGRESS_SLACK_MIN=1.5
OPTION_STEALTH_ORB_NO_PROGRESS_RELAX_MIN_MINUTES=11
OPTION_STEALTH_ORB_NO_PROGRESS_RELAX_MAX_MFE_PCT=0.06
OPTION_STEALTH_ORB_WATCHDOG_TRUSTED_SKIP_CLOCK_FREEZE=true
OPTION_STEALTH_ORB_DEGRADED_DRAWDOWN_TIGHTEN_SCALE=0.88

# -----------------------------------------------------------------------------
# 3) Shared portfolio cap — combined options book (ORB 0DTE + Trendline 0DTE)
# -----------------------------------------------------------------------------
# Per-path maxima: ORB0DTE.env (0DTE_MAX_POSITIONS), Trendline0DTE.env (TRENDLINE_MAX_OPEN_POSITIONS).
MAX_TOTAL_OPTION_POSITIONS=11

# -----------------------------------------------------------------------------
# 4) ORB boundaries & index capture (SO + 0DTE + ORB manager consumers)
# -----------------------------------------------------------------------------
# 7:30 re-check near-break tolerance (SO LONG + 0DTE SHORT vs ORB boundaries).
ORB_BREAK_TOLERANCE=0.0005
# VIX/SPX: Yahoo 15m RTH slice for true 6:30–6:45 PT ORB.
ORB_RTH_INTRADAY_SYMBOLS=VIX,SPX

# -----------------------------------------------------------------------------
# 5) Execution gating & portfolio hygiene (all paths)
# -----------------------------------------------------------------------------
ENABLE_SIGNAL_LEVEL_RED_DAY_FILTER=false
ENABLE_EXECUTION_FEATURE_SNAPSHOT=true
PREVENT_DUPLICATE_TRADES=true
# -----------------------------------------------------------------------------
# 6) Runtime shell (identity, modes, orchestration — keep lean; Data/Risk/Alerts own the rest)
# -----------------------------------------------------------------------------
PROJECT_NAME=Easy ORB Strategy
VERSION=2.0
ENVIRONMENT=development
TRADING_MODE=demo
STRATEGY_MODE=standard
AUTOMATION_MODE=demo
TRADING_ENABLED=true
POLL_SECONDS=1.0
TZ=America/New_York
PORT=8080
ENABLE_PRIME_SYSTEM=true
ENABLE_ALERT_MANAGER=true
ENABLE_RISK_MANAGEMENT=true
ENABLE_AUTO_TRADING=true
ENABLE_PERFORMANCE_TRACKING=true
DEMO_MODE_ENABLED=true
LIVE_MODE_ENABLED=false
AUTOMATION_ENABLED=true
KILL_SWITCH_ENABLED=true
SAFETY_CHECKS_ENABLED=true
LOG_FORMAT=json
LOG_TO_STDOUT=true
LOG_TO_FILE=false
LOG_LEVEL=INFO
