# =============================================================================
# Alerts.env — notification channels, routing, thresholds, throttling
# =============================================================================
# Merged by ConfigLoader after automation.env (see modules/config_loader.py).
# Telegram secrets: secretsprivate/telegram.env (local) or Secret Manager (prod).
#
# This file does not duplicate Shared.env keys. For cross-path trading policy
# (Red Day filter, duplicate-trade prevention, execution snapshots), see Shared.env.
# =============================================================================

# =============================================================================
# SHARED — defined in configs/Shared.env (reference only; no KEY= lines here)
# =============================================================================
# -- 1) Signal routing & generator --
#     PRIMARY_SIGNAL_GENERATOR
# -- 2) Options data policy --
#     REQUIRE_LIVE_OPTION_DATA
# -- 3) Position sizing (combined options book) --
#     MAX_TOTAL_OPTION_POSITIONS
# -- 4) ORB boundaries & index capture --
#     ORB_BREAK_TOLERANCE
#     ORB_RTH_INTRADAY_SYMBOLS
# -- 5) Execution gating & portfolio hygiene --
#     ENABLE_SIGNAL_LEVEL_RED_DAY_FILTER
#     ENABLE_EXECUTION_FEATURE_SNAPSHOT
#     PREVENT_DUPLICATE_TRADES
# =============================================================================

# =============================================================================
# PATH — Alerts & notifications (this file)
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Alert system master switches
# -----------------------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_SYSTEM_ENABLED=true
ALERT_MANAGER_ENABLED=true
PRIME_ALERT_MANAGER_ENABLED=true

# -----------------------------------------------------------------------------
# 2) Telegram
# -----------------------------------------------------------------------------
TELEGRAM_ALERTS_ENABLED=true
# SECURITY: Credentials loaded from secretsprivate/telegram.env (local) or Google Secret Manager (production)
# DO NOT hardcode secrets here - use secretsprivate/telegram.env for local development
TELEGRAM_RATE_LIMIT_ENABLED=true
TELEGRAM_ALERT_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# 3) Webhooks
# -----------------------------------------------------------------------------
WEBHOOK_ALERTS_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_ALERT_TYPES=entry,exit,error,performance

# -----------------------------------------------------------------------------
# 4) Email
# -----------------------------------------------------------------------------
EMAIL_ALERTS_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=etrade-strategy@yourdomain.com
EMAIL_TO=alerts@yourdomain.com
EMAIL_ALERT_TYPES=error,performance

# -----------------------------------------------------------------------------
# 5) Event types — what to alert on
# -----------------------------------------------------------------------------
ALERT_ON_ENTRY_SIGNALS=true
ALERT_ON_EXIT_SIGNALS=true
ALERT_ON_PERFORMANCE_ISSUES=true
ALERT_ON_DATA_FAILURES=true
ALERT_ON_API_LIMITS=true
# Cross-path digest toggles (moved from Shared.env May 2026)
ENABLE_SIGNAL_ALERTS=true
ENABLE_DAILY_PNL_SUMMARY=true
ENABLE_HOURLY_STATUS_UPDATES=true

# -----------------------------------------------------------------------------
# 6) Performance summaries (PnL / milestones)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 7) Thresholds — when numeric alerts fire
# -----------------------------------------------------------------------------
WEEKLY_PNL_ALERT_THRESHOLD_PCT=10.0
MONTHLY_PNL_ALERT_THRESHOLD_PCT=20.0
GAIN_THRESHOLD_ALERT_PCT=10.0
DRAWDOWN_THRESHOLD_ALERT_PCT=5.0

# -----------------------------------------------------------------------------
# 8) Scheduling — timezone & quiet hours
# -----------------------------------------------------------------------------
ALERT_START_TIME=09:30
ALERT_END_TIME=20:00

# -----------------------------------------------------------------------------
# 9) Throttling & deduplication
# -----------------------------------------------------------------------------
MAX_ALERTS_PER_DAY=500
ALERT_THROTTLING_ENABLED=true

# -----------------------------------------------------------------------------
# 10) Payload content & format
# -----------------------------------------------------------------------------
ALERT_INCLUDE_POSITION_DETAILS=true
ALERT_INCLUDE_PERFORMANCE_METRICS=true
ALERT_INCLUDE_RISK_METRICS=true
ALERT_INCLUDE_MARKET_DATA=true
ALERT_INCLUDE_SYSTEM_STATUS=true
ALERT_FORMAT=detailed
ALERT_EMOJI_ENABLED=true

# -----------------------------------------------------------------------------
# 11) Filtering — strategy / symbol / quality gates for noisy alerts
# -----------------------------------------------------------------------------
ALERT_FILTER_BY_STRATEGY=true
ALERT_FILTER_BY_SYMBOL=true
ALERT_FILTER_BY_CONFIDENCE=true
ALERT_MIN_CONFIDENCE_THRESHOLD=0.8
ALERT_MIN_QUALITY_THRESHOLD=60

# -----------------------------------------------------------------------------
# 12) Delivery health & analytics
# -----------------------------------------------------------------------------
ALERT_MONITORING_ENABLED=true
ALERT_DELIVERY_TRACKING=true
ALERT_FAILURE_TRACKING=true
ALERT_PERFORMANCE_TRACKING=true
ALERT_ANALYTICS_ENABLED=true

# -----------------------------------------------------------------------------
# 13) Retention & export
# -----------------------------------------------------------------------------
ALERT_STORAGE_ENABLED=true
ALERT_RETENTION_DAYS=90
ALERT_ARCHIVE_ENABLED=true
ALERT_EXPORT_ENABLED=true

# -----------------------------------------------------------------------------
# 14) Third-party integrations (optional)
# -----------------------------------------------------------------------------
ALERT_WEBHOOK_INTEGRATION=false
ALERT_DATABASE_INTEGRATION=false
ALERT_API_INTEGRATION=false
ALERT_SLACK_INTEGRATION=false
ALERT_DISCORD_INTEGRATION=false

# -----------------------------------------------------------------------------
# 15) Test / staging modes
# -----------------------------------------------------------------------------
ALERT_TEST_MODE=false
ALERT_TEST_CHAT_ID=
ALERT_TEST_FREQUENCY=hourly
ALERT_TEST_TYPES=system_status,performance

# -----------------------------------------------------------------------------
# 16) Meta — config validation / reload policy
# -----------------------------------------------------------------------------
ALERT_CONFIG_VALIDATION=true
ALERT_CONFIG_RELOAD=true
ALERT_CONFIG_BACKUP=true
ALERT_CONFIG_VERSIONING=true

# =============================================================================
# Consolidated May 2026 — former base/automation/deployment/trading-parameters
# =============================================================================
# === TELEGRAM CONFIGURATION ===
# SECURITY: Credentials loaded from secretsprivate/telegram.env (local) or Google Secret Manager (production)
# DO NOT hardcode secrets here - use secretsprivate/telegram.env for local development
TELEGRAM_MAX_MESSAGES_PER_MINUTE=20
# === DAILY PnL ALERT CONFIGURATION ===
DAILY_PNL_ALERTS_ENABLED=true
DAILY_ALERT_INCLUDE_POSITIONS=true
DAILY_ALERT_INCLUDE_PERFORMANCE=true
ALERT_ON_PERFORMANCE_DEGRADATION=true
# === AUTOMATION ALERTS ===
ALERT_ON_AUTOMATION_START=true
ALERT_ON_AUTOMATION_STOP=true
ALERT_ON_AUTOMATION_ERROR=true
ALERT_ON_AUTOMATION_OVERRIDE=true
ALERT_ON_AUTOMATION_LIMITS=true
# === TELEGRAM ALERT CONFIGURATION ===
TELEGRAM_ENABLED=true
# SECURITY: Credentials loaded from secretsprivate/telegram.env (local) or Google Secret Manager (production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TYPES=entry,exit,error,performance,daily_summary,system_status
# === TRADING ALERTS ===
ALERT_ON_SIGNAL_GENERATION=true
ALERT_ON_POSITION_OPENING=true
ALERT_ON_POSITION_CLOSING=true
ALERT_ON_STOP_LOSS_HIT=true
ALERT_ON_TAKE_PROFIT_HIT=true
ALERT_ON_SYSTEM_STATUS=true
# === PERFORMANCE ALERTS ===
ALERT_ON_DAILY_PNL=true
ALERT_ON_WEEKLY_PNL=true
ALERT_ON_MONTHLY_PNL=true
ALERT_ON_TRADE_SUMMARY=true
ALERT_ON_PERFORMANCE_MILESTONES=true
# === ALERT THRESHOLDS ===
DAILY_PNL_ALERT_THRESHOLD_PCT=5.0
LOSS_THRESHOLD_ALERT_PCT=-5.0
# === ALERT TIMING ===
DAILY_ALERT_TIME=16:05
WEEKLY_ALERT_TIME=16:00
MONTHLY_ALERT_TIME=16:00
ALERT_TIMEZONE=America/New_York
# === ALERT FREQUENCY CONTROL ===
MAX_ALERTS_PER_MINUTE=20
MAX_ALERTS_PER_HOUR=100
ALERT_COOLDOWN_MINUTES=5
DUPLICATE_ALERT_THRESHOLD_MINUTES=30
ALERT_MONITORING=true
ALERT_ON_ERRORS=true
ALERT_ON_LOSSES=true
ALERT_ON_GAINS=true

# =============================================================================
# Former configs/modes/standard.env + configs/environments/development.env
# (May 2026): merged into canonical seven; those paths removed from ConfigLoader.
# Last key wins — these lines override earlier duplicates in this file.
# =============================================================================
ALERT_BATCH_SIZE=5
ALERT_FREQUENCY_LIMIT=60
ALERT_ON_CACHE_EFFICIENCY=true
ALERT_ON_MEMORY_USAGE=true
ALERT_PRIORITY_QUEUE=true
