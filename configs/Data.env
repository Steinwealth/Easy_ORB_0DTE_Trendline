# =============================================================================
# Data.env — broker selection, accounts, data providers, caching, failover
# =============================================================================
# Merged May 2026 from: data-providers.env + broker-config.env
# Load order within this file: data-providers first, broker-config last
# (broker keys override data-providers on duplicates — matches former loader).
# Deprecated / disabled provider toggles belong in comments only — keep broker + account keys public here.
# =============================================================================

# === OPTIMIZED Data Provider Configuration ===
# High-performance data provider setup with intelligent caching and failover
# Last updated: 2026-01-09 (Rev 00236)

# === BROKER CONFIGURATION ===
# Rev 00245: PRIMARY source is configs/broker-config.env (broker selection + data policy)
# Load order: data-providers.env loads first, then broker-config.env overrides.
# Set BROKER_TYPE and BROKER_DATA_ONLY in broker-config.env for multi-broker switching.
# Supported brokers: etrade (default), ib, robinhood. Data policy: broker-only (no third-party).

# === PROVIDER PRIORITY (DEPRECATED - Rev 00236) ===
# NOTE: Provider priority is no longer used - all data comes from configured broker
# DATA_PRIORITY=etrade,alpha_vantage,yfinance
# PRIMARY_DATA_PROVIDER=etrade
# FALLBACK_PROVIDER=alpha_vantage
# BACKUP_PROVIDER=yfinance

# === ETRADE CONFIGURATION ===
ETRADE_TIMEOUT_SECONDS=10
ETRADE_RETRY_ATTEMPTS=3

# ETrade Account Requirements
ETRADE_MIN_BALANCE=1000
ETRADE_MARKET_DATA_AGREEMENTS=true
ETRADE_PROFESSIONAL_STATUS=false

# ETrade Performance Optimization
ETRADE_KEEPALIVE_TIMEOUT=30
ETRADE_MAX_RETRIES=3
ETRADE_BACKOFF_FACTOR=2.0
ETRADE_CIRCUIT_BREAKER_ENABLED=true
ETRADE_CIRCUIT_BREAKER_THRESHOLD=5
ETRADE_CIRCUIT_BREAKER_TIMEOUT=60

# === ALPHA VANTAGE CONFIGURATION (LEGACY - DISABLED) ===
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_RATE_LIMIT_MS=500
ALPHA_VANTAGE_TIMEOUT_SECONDS=15
ALPHA_VANTAGE_RETRY_ATTEMPTS=2
ALPHA_VANTAGE_COST_PER_MONTH=50

# Alpha Vantage Usage Strategy
ALPHA_VANTAGE_HISTORICAL_DATA=false
ALPHA_VANTAGE_TECHNICAL_INDICATORS=false
ALPHA_VANTAGE_REAL_TIME_FALLBACK=false
ALPHA_VANTAGE_PRE_MARKET_SCANNING=false

# Alpha Vantage Performance Optimization
ALPHA_VANTAGE_KEEPALIVE_TIMEOUT=30
ALPHA_VANTAGE_MAX_RETRIES=2
ALPHA_VANTAGE_BACKOFF_FACTOR=1.5
ALPHA_VANTAGE_CIRCUIT_BREAKER_ENABLED=true
ALPHA_VANTAGE_CIRCUIT_BREAKER_THRESHOLD=3
ALPHA_VANTAGE_CIRCUIT_BREAKER_TIMEOUT=120

# === YAHOO FINANCE CONFIGURATION ===
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_RATE_LIMIT_MS=200
YAHOO_FINANCE_TIMEOUT_SECONDS=10
YAHOO_FINANCE_RETRY_ATTEMPTS=2
YAHOO_FINANCE_DELAYED_DATA=true
YAHOO_FINANCE_COST_PER_MONTH=0

# Yahoo Finance Performance Optimization
YAHOO_FINANCE_KEEPALIVE_TIMEOUT=30
YAHOO_FINANCE_MAX_RETRIES=2
YAHOO_FINANCE_BACKOFF_FACTOR=1.2
YAHOO_FINANCE_CIRCUIT_BREAKER_ENABLED=true
YAHOO_FINANCE_CIRCUIT_BREAKER_THRESHOLD=5
YAHOO_FINANCE_CIRCUIT_BREAKER_TIMEOUT=60

# === OPTIMIZED DATA CACHING CONFIGURATION ===
CACHE_ENABLED=true
CACHE_SIZE_LIMIT=1000
CACHE_QUOTES_TTL_SECONDS=1
CACHE_HISTORICAL_TTL_SECONDS=300
CACHE_INDICATORS_TTL_SECONDS=600
CACHE_CLEANUP_INTERVAL_SECONDS=3600

# Advanced caching features
CACHE_COMPRESSION_ENABLED=true
CACHE_DEDUPLICATION_ENABLED=true
CACHE_PRELOADING_ENABLED=true
CACHE_WARMUP_ENABLED=true
CACHE_STATISTICS_ENABLED=true

# Cache performance optimization
CACHE_HIT_RATE_TARGET=80
CACHE_MEMORY_LIMIT_MB=500
CACHE_DISK_LIMIT_MB=1000
CACHE_CLEANUP_THRESHOLD=0.8
CACHE_EVICTION_POLICY=LRU

# === OPTIMIZED FAILOVER CONFIGURATION ===
FAILOVER_ENABLED=true
FAILOVER_MAX_CONSECUTIVE_FAILURES=5
FAILOVER_NOTIFICATION_ENABLED=true

# Advanced failover features
FAILOVER_HEALTH_CHECK_INTERVAL=30
FAILOVER_AUTO_RECOVERY=true
FAILOVER_GRACEFUL_DEGRADATION=true
FAILOVER_LOAD_BALANCING=true
FAILOVER_CIRCUIT_BREAKER=true

# === OPTIMIZED DAILY CALL DISTRIBUTION STRATEGY ===
# Pre-Market (4:30 AM - 9:30 AM)
PRE_MARKET_ALPHA_VANTAGE_CALLS=0
PRE_MARKET_ETRADE_CALLS=0
PRE_MARKET_YAHOO_CALLS=unlimited

# Market Open (9:30 AM - 11:30 AM)
MARKET_OPEN_ALPHA_VANTAGE_CALLS=0
MARKET_OPEN_ETRADE_CALLS=continuous
MARKET_OPEN_YAHOO_CALLS=unlimited

# Mid-Day (11:30 AM - 2:00 PM)
MID_DAY_ALPHA_VANTAGE_CALLS=0
MID_DAY_ETRADE_CALLS=continuous
MID_DAY_YAHOO_CALLS=unlimited

# Late Day (2:00 PM - 4:00 PM)
LATE_DAY_ALPHA_VANTAGE_CALLS=0
LATE_DAY_ETRADE_CALLS=continuous
LATE_DAY_YAHOO_CALLS=unlimited

# After Hours (4:00 PM - 9:00 PM)
AFTER_HOURS_ALPHA_VANTAGE_CALLS=0
AFTER_HOURS_ETRADE_CALLS=0
AFTER_HOURS_YAHOO_CALLS=unlimited

# === OPTIMIZATION SETTINGS ===
BATCH_REQUEST_ENABLED=true
BATCH_SIZE_LIMIT=50
PARALLEL_PROCESSING_ENABLED=true
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30

# Advanced optimization features
ENABLE_REQUEST_BATCHING=true
ENABLE_RESPONSE_CACHING=true
ENABLE_CONNECTION_REUSE=true
ENABLE_HTTP_KEEPALIVE=true
ENABLE_COMPRESSION=true

# Performance tuning
MAX_CONCURRENT_CONNECTIONS=20
CONNECTION_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=30
WRITE_TIMEOUT_SECONDS=30
KEEPALIVE_TIMEOUT_SECONDS=30

# === MONITORING CONFIGURATION ===
CALL_MONITORING_ENABLED=true
PERFORMANCE_TRACKING_ENABLED=true
ALERT_ON_HIGH_USAGE=true
ALERT_ON_FAILOVER=true
DAILY_REPORT_ENABLED=true

# Advanced monitoring
LATENCY_MONITORING_ENABLED=true
THROUGHPUT_MONITORING_ENABLED=true
ERROR_RATE_MONITORING_ENABLED=true
CACHE_EFFICIENCY_MONITORING_ENABLED=true
COST_MONITORING_ENABLED=true

# === DATA QUALITY SETTINGS ===
MIN_VOLUME_THRESHOLD=100000
MAX_SPREAD_PERCENTAGE=0.5
MIN_PRICE_THRESHOLD=5.0
MAX_PRICE_THRESHOLD=1000.0
DATA_VALIDATION_ENABLED=true

# Advanced data quality features
DATA_SANITIZATION_ENABLED=true
DATA_NORMALIZATION_ENABLED=true
DATA_COMPLETENESS_CHECK=true
DATA_CONSISTENCY_CHECK=true
DATA_FRESHNESS_CHECK=true

# === HISTORICAL DATA CONFIGURATION ===
HISTORICAL_DATA_LOOKBACK_DAYS=30
HISTORICAL_DATA_TIMEFRAME=1min
HISTORICAL_DATA_CACHE_ENABLED=true
HISTORICAL_DATA_COMPRESSION=true

# Historical data optimization
HISTORICAL_DATA_BATCH_SIZE=100
HISTORICAL_DATA_PARALLEL_WORKERS=4
HISTORICAL_DATA_CACHE_TTL=3600
HISTORICAL_DATA_COMPRESSION_LEVEL=6

# === TECHNICAL INDICATORS CONFIGURATION ===
TECHNICAL_INDICATORS_ENABLED=true
DEFAULT_INDICATORS=RSI,MACD,SMA,EMA,ATR,BBANDS
INDICATOR_CALCULATION_CACHE=true
INDICATOR_REFRESH_INTERVAL_SECONDS=300

# Technical indicators optimization
INDICATOR_CACHE_SIZE=1000
INDICATOR_CACHE_TTL=600
INDICATOR_PARALLEL_CALCULATION=true
INDICATOR_BATCH_SIZE=50

# === MARKET SCANNING CONFIGURATION ===
MARKET_SCAN_ENABLED=true
MARKET_SCAN_INTERVAL_SECONDS=300
MARKET_SCAN_BATCH_SIZE=50
MARKET_SCAN_CRITERIA_FILE=data/scan_criteria.json

# Market scanning optimization
MARKET_SCAN_PARALLEL_WORKERS=4
MARKET_SCAN_CACHE_TTL=180
MARKET_SCAN_MEMORY_LIMIT_MB=256
MARKET_SCAN_PRIORITY_QUEUE=true

# === COST MANAGEMENT ===
TOTAL_MONTHLY_COST=100
COST_TRACKING_ENABLED=true
ETRADE_COST_PER_MONTH=0
YAHOO_COST_PER_MONTH=0
GOOGLE_CLOUD_COST_PER_MONTH=50

# Cost optimization
COST_ALERT_THRESHOLD=0.5
COST_AUTO_OPTIMIZATION=true
COST_BUDGET_ALERTS=true
COST_TREND_ANALYSIS=true

# === PERFORMANCE TARGETS ===
TARGET_LATENCY_MS=100
TARGET_CACHE_HIT_RATE=80
TARGET_SUCCESS_RATE=95
TARGET_DAILY_CALLS_ETRADE=1180
TARGET_DAILY_CALLS_ALPHA_VANTAGE=0

# Advanced performance targets
TARGET_THROUGHPUT_RPS=50
TARGET_MEMORY_USAGE_MB=512
TARGET_CPU_USAGE_PCT=50
TARGET_ERROR_RATE_PCT=5

# === EMERGENCY SETTINGS ===
# Rev 00236 (Jan 9, 2026): Emergency fallback removed - must use broker data only
# If broker fails, system stops trading (no third-party fallback)
EMERGENCY_FALLBACK_ENABLED=false  # Rev 00236: Disabled - broker data only
# EMERGENCY_DATA_PROVIDER=yfinance  # DEPRECATED - conflicts with BROKER_DATA_ONLY
EMERGENCY_NOTIFICATION_ENABLED=true
EMERGENCY_STOP_TRADING=true  # Rev 00236: Stop trading if broker fails (no fallback)

# Emergency optimization
EMERGENCY_CACHE_CLEAR=true
EMERGENCY_CONNECTION_RESET=true
EMERGENCY_MODE_SIMPLIFIED=true
EMERGENCY_LOGGING_LEVEL=WARNING


# === BROKER CONFIGURATION ===
# Easy ORB Strategy - Multi-Broker Support Configuration
# Rev 00245 (Jan 19, 2026): Unified broker and account selection
# Last updated: 2026-02-09

# === DATA POLICY (multi-broker, configurable) ===
# All market data (quotes, ORB, validation candle) comes from the broker selected by BROKER_TYPE.
# No third-party data sources; switch broker by changing BROKER_TYPE and broker-specific account/env below.

# === PRIMARY BROKER SELECTION ===
# Set the primary broker for the entire system
# Supported brokers: etrade (default), ib (Interactive Brokers), robinhood
# All strategies will use this broker unless overridden per-strategy

# === STRATEGY-SPECIFIC BROKER OVERRIDES ===
# Each strategy can optionally use a different broker
# If not set, uses BROKER_TYPE above
# Format: ORB_BROKER_TYPE=etrade|ib|robinhood
# Format: 0DTE_BROKER_TYPE=etrade|ib|robinhood
# Uncomment and set if you want different brokers per strategy:
# ORB_BROKER_TYPE=etrade
# 0DTE_BROKER_TYPE=etrade

# === ETRADE CONFIGURATION ===
# E*TRADE Broker Settings
# OAuth: Production token only (sandbox token not used). Demo mode = simulated Demo account; Live mode = live broker account.
#
# Demo mode: ORB uses $1,000 mock sim balance; 0DTE uses $5,000 mock sim balance (no real money).
#   Set ETRADE_ORB_ACCOUNT_ID / ETRADE_0DTE_ACCOUNT_ID to your E*TRADE Sim account ID for API calls (quotes, chain).
#   If the ID is invalid or not found, the app uses the auto-selected Sim account and continues.
# Live mode: ORB and 0DTE use the configured account IDs for real trading on the broker live account.

# ETrade - ORB Strategy Account
# Account ID: 775690861 "Steinwealth" (ORB ETF Trading)
ETRADE_ORB_ACCOUNT_ID=775690861
ETRADE_ORB_ACCOUNT_NAME=Steinwealth

# ETrade - 0DTE Strategy Account  
# Account ID: 215107721 (0DTE Options Trading)
ETRADE_0DTE_ACCOUNT_ID=215107721
ETRADE_0DTE_ACCOUNT_NAME=

# ETrade - Default Account (if strategy-specific not set)
ETRADE_DEFAULT_ACCOUNT_ID=775690861

# ETrade trading mode: demo = simulated Demo account (production API); live = live trading on broker account
# DEPLOYMENT_MODE (demo|live) in deployment.env controls which account is used; E*TRADE always uses Production OAuth token.
# Sandbox is deprecated: data and API use production only. ETRADE_ENVIRONMENT=prod (sandbox not used).
ETRADE_ENVIRONMENT=prod

# ETrade API Settings
ETRADE_ENABLED=true
ETRADE_REAL_TIME_QUOTES=true
ETRADE_BATCH_QUOTES=true
ETRADE_DAILY_CALL_LIMIT=1180
ETRADE_RATE_LIMIT_CALLS_PER_MINUTE=100

# === INTERACTIVE BROKERS CONFIGURATION ===
# Interactive Brokers Broker Settings
# (Placeholder for future implementation)

# IB - ORB Strategy Account
# IB_ORB_ACCOUNT_ID=
# IB_ORB_ACCOUNT_NAME=

# IB - 0DTE Strategy Account
# IB_0DTE_ACCOUNT_ID=
# IB_0DTE_ACCOUNT_NAME=

# IB - Default Account
# IB_DEFAULT_ACCOUNT_ID=

# IB API Settings
IB_ENABLED=false
IB_ENVIRONMENT=paper  # paper or live

# === ROBINHOOD CONFIGURATION ===
# Robinhood Broker Settings
# (Placeholder for future implementation)

# Robinhood - ORB Strategy Account
# RH_ORB_ACCOUNT_ID=
# RH_ORB_ACCOUNT_NAME=

# Robinhood - 0DTE Strategy Account
# RH_0DTE_ACCOUNT_ID=
# RH_0DTE_ACCOUNT_NAME=

# Robinhood - Default Account
# RH_DEFAULT_ACCOUNT_ID=

# Robinhood API Settings
ROBINHOOD_ENABLED=false
ROBINHOOD_ENVIRONMENT=sandbox  # sandbox or live

# === ACCOUNT SELECTION LOGIC ===
# The system uses the following logic to select accounts:
# 1. Check strategy-specific account (e.g., ETRADE_ORB_ACCOUNT_ID)
# 2. If not set, check default account (e.g., ETRADE_DEFAULT_ACCOUNT_ID)
# 3. If not set, auto-select first available active account
#
# Priority: Strategy Account > Default Account > Auto-select

# === BROKER SWITCHING NOTES ===
# To switch brokers:
# 1. Set BROKER_TYPE to new broker (e.g., ib or robinhood)
# 2. Update broker-specific account IDs above
# 3. Ensure broker credentials are configured (API keys, OAuth tokens)
# 4. Restart the system
#
# The system will automatically use the new broker and account IDs

# =============================================================================
# Consolidated May 2026 — former base/automation/deployment/trading-parameters
# =============================================================================
# === OPTIMIZED DATA PROVIDER CONFIGURATION ===
# Rev 00236 (Jan 9, 2026): DATA_PRIORITY deprecated - use BROKER_TYPE in Data.env
# All data comes from configured broker (BROKER_TYPE) - no third-party fallback
# DATA_PRIORITY=etrade,polygon,yfinance  # DEPRECATED - use BROKER_TYPE instead
FAILOVER_BAD_PULLS=3
FAILOVER_COOLDOWN_SECONDS=60
DATA_CACHE_SIZE_MB=500
DATA_CACHE_TTL_SECONDS=300
CORE_SYMBOL_COUNT=33
DYNAMIC_SYMBOL_COUNT=32
# Scanner performance
SCANNER_BATCH_SIZE=20
SCANNER_PARALLEL_WORKERS=4
SCANNER_CACHE_TTL_SECONDS=180
SCANNER_MEMORY_LIMIT_MB=256
# === WATCHLIST CONFIGURATION ===
WATCHLIST_FILE=data/hybrid_watchlist.csv
CORE_SYMBOLS=SPY,QQQ,IWM,DIA,VTI,VOO,TSLA,NVDA,AAPL,AMD,MSFT,META,MU,AMZN,GOOGL,TQQQ,SQQQ,SOXL,SOXS,ARKK,XLF,XLE,XLK,XLC,XLB,XLV,XLI,XLY,TSLL,ERX,GOOGL2L
# === DATA PATHS ===
HYBRID_LIST_PATH=data/hybrid_watchlist.csv
STATE_PATH=data/state.json
SYMBOL_PERFORMANCE_LOG=data/symbol_performance.json
# === DEPLOYMENT CONFIGURATION ===
# Easy ORB Strategy - Configuration for Google Cloud deployment with Demo/Live automation modes
# Last updated: 2026-01-06 (Rev 00231)
# === DEPLOYMENT MODE ===
# demo = trade on simulated Demo account (E*TRADE Production API + Demo account)
# live = live trading on broker account (E*TRADE Production API + Live account)
# E*TRADE OAuth: Production tokens only (sandbox deprecated). Demo = sim account, Live = live account.
DEPLOYMENT_MODE=demo
# === BROKER CONFIGURATION ===
# Primary: configs/Data.env (broker + accounts). Deployment overrides below (load order: deployment.env last).
# Supported brokers: etrade (default), ib, robinhood. Data policy: broker-only (BROKER_DATA_ONLY=true).
BROKER_TYPE=etrade
BROKER_DATA_ONLY=true
# === GOOGLE CLOUD CONFIGURATION ===
# Rev 00190: Centralized cloud configuration for easy deployment to different projects
# Change these values to deploy to a different GCP project
GCP_PROJECT_ID=easy-etrade-strategy
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_SERVICE_NAME=easy-etrade-strategy
GCS_BUCKET_NAME=easy-etrade-strategy-data
# GCS_BUCKET_NAME can be auto-derived from GCP_PROJECT_ID if not set: {GCP_PROJECT_ID}-data
GCP_CONTAINER_IMAGE=gcr.io/easy-etrade-strategy/easy-etrade-strategy:latest
# === CONTAINER CONFIGURATION ===
CONTAINER_CPU=2
CONTAINER_MEMORY=4Gi
CONTAINER_MAX_INSTANCES=10
CONTAINER_MIN_INSTANCES=0  # CRITICAL: Set to 0 for scale-to-zero (saves ~$120/month)
CONTAINER_TIMEOUT=300s
# === HEALTH CHECK CONFIGURATION ===
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_PATH=/health
# === MONITORING CONFIGURATION ===
METRICS_ENABLED=true
METRICS_PORT=8080
METRICS_PATH=/metrics
# === SECURITY CONFIGURATION ===
SECURE_TOKEN_STORAGE=true
ENCRYPT_SENSITIVE_DATA=true
AUDIT_LOGGING=true
ACCESS_CONTROL=true
# === BACKUP CONFIGURATION ===
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_TO_GCS=true
# === AUTO-SCALING CONFIGURATION ===
AUTO_SCALING_ENABLED=true
MIN_INSTANCES=1
MAX_INSTANCES=10
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=80
# === NETWORK CONFIGURATION ===
ALLOWED_IPS=0.0.0.0/0
SSL_CERTIFICATE_PATH=/etc/ssl/certs
SSL_PRIVATE_KEY_PATH=/etc/ssl/private
# === ENVIRONMENT VARIABLES ===
PYTHONPATH=/app
PYTHONUNBUFFERED=1
# === DEPLOYMENT SAFETY ===
DEPLOYMENT_SAFETY_CHECKS=true
PRE_DEPLOYMENT_TESTS=true
POST_DEPLOYMENT_VALIDATION=true
ROLLBACK_ENABLED=true
# Symbol List Configuration (Rev 00173) ⭐
# ARCHIVED: Symbol selection no longer used - all symbols from core_list.csv used
# SYMBOL_SELECTION_METHOD=static  # ❌ ARCHIVED
CORE_LIST_PATH=data/watchlist/core_list.csv  # ⭐ PRIMARY: full core_list.csv row set (dynamic count)
CORE_SYMBOLS_COUNT=101  # Doc-only hint; ORB capture uses all rows from CORE_LIST_PATH (keep in sync with CSV or treat as informational)
# DYNAMIC_SYMBOLS_ENABLED=false  # ❌ ARCHIVED
MAX_SYMBOLS_TO_TRADE=25
# News Integration
NEWS_SENTIMENT_ENABLED=true
NEWS_SENTIMENT_THRESHOLD=0.3
NEWS_IMPACT_WEIGHT=0.2

# =============================================================================
# Former configs/modes/standard.env + configs/environments/development.env
# (May 2026): merged into canonical seven; those paths removed from ConfigLoader.
# Last key wins — these lines override earlier duplicates in this file.
